# JaipurAir Environment Configuration

# OpenWeatherMap API Key (free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ML Service URL (where FastAPI runs)
ML_SERVICE_URL=http://localhost:8000

# Express server port
PORT=3000

# Alert thresholds (µg/m³)
PM25_WARNING=60
PM25_DANGEROUS=120

# Database path
DB_PATH=./aqi.db
